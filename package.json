{
  "name": "cpl-server",
  "version": "1.11.0-beta",
  "description": "Node game server for Club Penguin Live: authentication, Socket.IO game protocol, and the MySQL-backed economy.",
  "scripts": {
    "dev": "babel-watch ./src/World.js Login Blizzard",
    "build": "rimraf dist && babel src -d dist --copy-files",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "list": "pm2 list",
    "logs": "pm2 logs",
    "monit": "pm2 monit",
    "secret-gen": "node ./utils/secret-gen.js",
    "migrate": "node ./utils/migrate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clubpenguinlive/cpl-server.git"
  },
  "author": "wizguin (original yukon-server), Club Penguin Live contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/clubpenguinlive/cpl-server/issues"
  },
  "homepage": "https://github.com/clubpenguinlive/cpl-server#readme",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.3",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-watch": "^7.8.1",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "fastest-validator": "^1.19.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.17.0",
    "nodemailer": "^9.0.1",
    "pm2": "^7.0.0",
    "rate-limiter-flexible": "^7.2.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5"
  },
  "overrides": {
    "lodash": "4.18.1",
    "dottie": "2.0.7",
    "systeminformation": "5.31.7",
    "validator": "13.15.26",
    "jws": "3.2.3",
    "ws": "8.21.0",
    "socket.io-parser": "4.2.6",
    "basic-ftp": "6.0.0",
    "follow-redirects": "1.16.0",
    "js-yaml": "4.2.0"
  }
}
