# CPL container stack config + secrets. Copy to .env (gitignored) on the host, fill, never commit.
# Single source for every service (decision 8): the four old DB-credential copies collapse here.

# --- image promotion ---
REGISTRY=ghcr.io/clubpenguinlive
IMAGE_TAG=stable

# --- database (mariadb init uses these on a FRESH volume; the cutover restore preserves data) ---
DB_ROOT_PASSWORD=
DB_NAME=clubpenguinlive
DB_USER=yukon
DB_PASSWORD=
DB_HOST=mariadb

# --- node game server ---
CRYPTO_SECRET=
BCRYPT_ROUNDS=10
LOGIN_KEY_EXPIRY=300
CORS_ORIGIN=https://play.clubpenguinlive.net
BLIZZARD_MAX_USERS=300

# --- NPCs / mascot visits ---
BOTS_ENABLED=true
# MASCOT_VISITS: JSON array of timed mascot room appearances. Mascot names must match PRESETS in BotManager.js.
# Example: [{"mascot":"Rockhopper","room":100,"start":"2026-06-21T18:00:00Z","end":"2026-06-21T20:00:00Z"}]
MASCOT_VISITS=[]

# --- email / MFA (Resend). Empty RESEND_API_KEY = scaffold mode (codes logged, no send). ---
RESEND_API_KEY=
EMAIL_FROM=Club Penguin Live <no-reply@clubpenguinlive.net>
EMAIL_FORCE_VERIFICATION=false
# EMAIL_SKIP_FOR must be a JSON array of lowercase emails that skip the code (e.g. the smoke-test account)
EMAIL_SKIP_FOR=[]
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend

# --- cloudflare tunnel: prod token, or the test-tunnel token during play-ctest validation ---
TUNNEL_TOKEN=
